# ============================================================
# Power BI PDF Summarizer — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control!
# ============================================================

# --- Microsoft Azure AD App Registration ---
# Register at: https://portal.azure.com → App registrations
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# --- Email Configuration ---
# The mailbox that receives the Power BI report
MAILBOX_USER=reports@yourcompany.com

# Filter to find the right email (matches subject line)
EMAIL_SUBJECT_FILTER=Power BI

# Optional: filter by sender address (leave blank to skip)
EMAIL_SENDER_FILTER=

# Comma-separated list of recipient email addresses
RECIPIENT_EMAILS=ceo@yourcompany.com,cfo@yourcompany.com,vp-ops@yourcompany.com

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# --- Report Branding ---
COMPANY_NAME=Acme Corp
REPORT_NAME=Daily Performance Report

# Link to the full Power BI report (shown as a button in the email)
FULL_REPORT_URL=https://app.powerbi.com/your-report-link

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
